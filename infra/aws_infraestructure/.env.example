# diffwise self-hosted PR gate on AWS
# Copy to infra/aws_infraestructure/.env (gitignored), fill it in, then run ./deploy.sh
# Nothing here is sent to ByePaper. These values are used only on this machine, by Terraform.

# --- Deployment type ---
#   small  Serverless, the database pauses when idle. About 2-10 USD/month before LLM usage.
#          For startups and small teams (up to a few thousand PRs a month).
#   full   Production layout: EC2 workers in private subnets, database that never pauses,
#          multi-AZ failover, WAF, customer KMS key. About 330 USD/month before LLM usage.
DIFFWISE_DEPLOYMENT=small

# --- AWS credentials (used only on this machine, only by Terraform) ---
# Prefer temporary credentials (AWS_SESSION_TOKEN) or AWS_PROFILE with SSO over long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
AWS_REGION=us-east-1

# --- Terraform state ---
# deploy.sh creates this bucket (versioned, encrypted, private) if it does not exist.
DIFFWISE_TF_STATE_BUCKET=
DIFFWISE_ENVIRONMENT=prod                    # prefix for every resource name

# --- Who may call the gate ---
DIFFWISE_ALLOWED_GITHUB_ORGS=                # comma-separated, e.g. acme,acme-labs

# --- LLM ---
DIFFWISE_LLM_PROVIDER=bedrock                # bedrock | gemini | offline
DIFFWISE_BEDROCK_MODEL_ID=                   # a model or inference profile id enabled in your region
# GEMINI_API_KEY=                            # only if DIFFWISE_LLM_PROVIDER=gemini; stored in SSM, never in state
# GEMINI_MODEL=gemini-3.8-flash

# --- Alerts (optional) ---
# DIFFWISE_ALARM_EMAIL=ops@example.com       # AWS sends a confirmation email first

# --- Sizing overrides (optional; empty = preset value) ---
# DIFFWISE_REPORT_RETENTION_DAYS=            # small 14, full 30
# DIFFWISE_DB_MIN_ACU=                       # small 0 (pauses when idle), full 0.5
# DIFFWISE_DB_MAX_ACU=                       # small 2, full 8
# DIFFWISE_DB_MULTI_AZ=                      # small false, full true
# DIFFWISE_WORKER_MAX=                       # small: concurrent worker Lambdas (2); full: max EC2 workers (10)
# DIFFWISE_WORKER_MIN=                       # full only (1)
# DIFFWISE_WORKER_INSTANCE_TYPE=             # full only (c7g.large)
# DIFFWISE_ENABLE_WAF=                       # small false, full true
