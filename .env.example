# Copy this file to .env (in the work_load_understand folder) and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini model id that supports generateContent.
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Language for generated text (prompts and output rules stay the same).
# WLU_OUTPUT_LANGUAGE=English

# Optional. Max characters of diff sent to Gemini per request (default 600000).
# WLU_MAX_CONTEXT_CHARS=600000

# Optional. Web UI port (default 4747).
# WLU_PORT=4747

# Optional. Where your customized prompts are stored
# (default ~/.config/work-load-understand/prompts).
# WLU_PROMPTS_DIR=
